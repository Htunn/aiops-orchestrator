{
  "mcpServers": {
    "kubernetes": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "scripts/mcp_server.py"
      ],
      "description": "Kubernetes management tools via kubectl",
      "tools": [
        "k8s_get_pods",
        "k8s_get_nodes",
        "k8s_get_deployments",
        "k8s_get_services",
        "k8s_get_namespaces",
        "k8s_get_logs",
        "k8s_scale_deployment",
        "k8s_describe_resource",
        "k8s_get_events",
        "k8s_top_pods",
        "k8s_top_nodes",
        "k8s_get_contexts",
        "k8s_current_context"
      ]
    },
    "azure": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "scripts/azure_mcp_server.py"
      ],
      "description": "Azure Resource Manager (ARM) tools — SPEC-002. Degrades gracefully (tools return an error) when config/azure_resources.yml has no subscriptions or Entra ID credentials are not set.",
      "tools": [
        "azure_list_resource_groups",
        "azure_list_vms",
        "azure_get_vm",
        "azure_list_vmss",
        "azure_list_app_services",
        "azure_list_aks_clusters",
        "azure_resource_health",
        "azure_activity_log",
        "azure_resource_metrics",
        "azure_restart_vm",
        "azure_scale_vmss",
        "azure_scale_app_service_plan",
        "azure_restart_aks_nodepool",
        "azure_deallocate_vm",
        "azure_delete_resource"
      ]
    },
    "platform": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "scripts/platform_mcp_server.py"
      ],
      "description": "VM platform (Nutanix/VMware/OpenShift) tools — SPEC-003. Degrades gracefully (tools return an error) when a platform is not configured.",
      "tools": [
        "platform_list_vms",
        "platform_get_vm",
        "platform_list_hosts",
        "platform_restart_vm",
        "platform_start_vm",
        "platform_stop_vm"
      ]
    },
    "simplePortChecker": {
      "type": "sse",
      "url": "https://mcp.simpleportchecker.com/mcp",
      "description": "Port checking and network connectivity tools"
    }
  },
  "env": {
    "KUBECONFIG": "~/.kube/config"
  },
  "notes": [
    "This configuration file defines MCP servers that can be used by the AI agent.",
    "Supported transport types:",
    "  - stdio: subprocess-based servers (e.g., Kubernetes)",
    "  - sse: HTTP-based servers with Server-Sent Events (e.g., simplePortChecker)",
    "The manager automatically routes tool calls to the appropriate server.",
    "Make sure kubectl is installed and configured before using Kubernetes tools.",
    "",
    "To add an SSE-based MCP server:",
    "{",
    "  \"serverName\": {",
    "    \"type\": \"sse\",",
    "    \"url\": \"https://your-mcp-server.com/mcp\",",
    "    \"apiKey\": \"optional-api-key\",",
    "    \"description\": \"Server description\"",
    "  }",
    "}"
  ]
}